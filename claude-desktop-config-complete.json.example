{
  "mcpServers": {
    "_comment": "=== PYTHON INSTALLATION MODES ===",
    
    "joplin-python-installed": {
      "_comment": "Python package installation (pip/pipx) - STDIO transport (recommended for Claude Desktop)",
      "command": "joplin-mcp-server",
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    },
    
    "joplin-python-uvx": {
      "_comment": "Python uvx installation - STDIO transport (zero-install testing)",
      "command": "uvx",
      "args": ["joplin-mcp"],
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    },
    
    "_comment": "=== DOCKER DEPLOYMENT MODES ===",
    
    "joplin-docker-dev": {
      "_comment": "Docker development mode - STDIO transport with live code changes",
      "command": "docker",
      "args": [
        "run", "--rm", "-i", "--network", "host",
        "-v", "/path/to/project/src:/app/src",
        "-v", "/path/to/project/joplin-mcp.json:/app/joplin-mcp.json",
        "joplin-mcp:dev",
        "python", "run_fastmcp_server.py"
      ],
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    },
    
    "joplin-docker-prod": {
      "_comment": "Docker production mode - STDIO transport, self-contained",
      "command": "docker",
      "args": [
        "run", "--rm", "-i", "--network", "host",
        "-v", "/path/to/project/joplin-mcp.json:/app/joplin-mcp.json",
        "joplin-mcp:prod",
        "python", "run_fastmcp_server.py"
      ],
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    },
    
    "_comment": "=== HTTP TRANSPORT MODES (require separate server startup) ===",
    
    "joplin-sse": {
      "_comment": "SSE transport - Start server: python run_fastmcp_server.py --transport sse",
      "transport": "sse",
      "url": "http://localhost:8000/mcp",
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    },
    
    "joplin-http": {
      "_comment": "HTTP transport - Start server: python run_fastmcp_server.py --transport http",
      "transport": "http",
      "url": "http://localhost:8000/mcp",
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    },
    
    "joplin-streamable-http": {
      "_comment": "Streamable HTTP transport - Start server: python run_fastmcp_server.py --transport streamable-http",
      "transport": "streamable-http", 
      "url": "http://localhost:8000/mcp",
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    },
    
    "_comment": "=== DOCKER HTTP TRANSPORT MODES ===",
    
    "joplin-docker-sse": {
      "_comment": "Docker SSE transport - Start: docker run --network host joplin-mcp:prod python run_fastmcp_server.py --transport sse",
      "transport": "sse",
      "url": "http://localhost:8000/mcp",
      "env": {
        "JOPLIN_TOKEN": "${JOPLIN_TOKEN}"
      }
    }
  },
  
  "_usage_notes": {
    "environment_setup": "export JOPLIN_TOKEN='your_joplin_api_token_here'",
    "joplin_token_source": "Joplin Desktop → Tools → Options → Web Clipper → Authorization token",
    "docker_build_commands": [
      "docker build --target development -t joplin-mcp:dev .",
      "docker build --target production -t joplin-mcp:prod ."
    ],
    "path_substitution": "Replace /path/to/project with your actual project path in Docker volume mounts",
    "recommended_modes": {
      "development": "joplin-docker-dev or joplin-python-installed",
      "production": "joplin-docker-prod or joplin-python-installed",  
      "testing": "joplin-python-uvx",
      "multi_mcp": "joplin-docker-sse or joplin-sse"
    }
  }
}